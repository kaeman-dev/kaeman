{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "target": "es2022",
    "lib": ["es2024", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "#*": ["./src/*"]
    },
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src"]
}
