{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "target": "es2022",
    "lib": ["es2024", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "strictNullChecks": false,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
  },
  "include": [
    "src"
  ]
}
